# Personal documents — LOCAL ONLY. This repo is public; your paperwork is not.
Application_Packages/*
Other Docs/*
application/CV/*/*
Companies/
# ...but ship the empty folder skeleton, so a fresh clone has somewhere to put things.
!Application_Packages/.gitkeep
!Other Docs/.gitkeep
!application/CV/*/.gitkeep

# Secrets / portal access notes — never push
credentials.md
application/credentials_notes.json

# Dashboard: regenerated by scripts/build_dashboard.py and embeds the full
# tracker (companies, positions, rejection notes). Rebuild it locally.
progress.html

# Scratch working files for a batch, cached posting sweeps
tmp/
.cache/
agent-workspace/

# Loose screenshots dropped in the repo root by a browsing agent. Real evidence
# lives as confirmation.png inside the job's Application_Packages/ folder.
/*.png

# Office lock files
~$*
*.tmp

# Python
__pycache__/
*.pyc
